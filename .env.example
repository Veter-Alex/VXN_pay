# App
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string

# Database
DATABASE_URL=postgresql+asyncpg://vxnpay:vxnpay_secret@db:5432/vxnpay
POSTGRES_USER=vxnpay
POSTGRES_PASSWORD=vxnpay_secret
POSTGRES_DB=vxnpay

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Bootstrap admin (создаётся при первом старте, если admin ещё нет)
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# Rate limiting (login)
LOGIN_RATE_LIMIT=5/minute

# SMTP (заглушка — реальная отправка в следующих фазах)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true

# Billing domain (фаза C)
BILLING_DOMAIN=example-learning.ru

# Telegram (фаза D)
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=
TELEGRAM_LOGIN_BOT_USERNAME=

# YuKassa (фаза C)
YUKASSA_STUB_MODE=true
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
YUKASSA_WEBHOOK_SECRET=
YUKASSA_API_URL=https://api.yookassa.ru/v3
PAYMENT_DESCRIPTION=Благодарность за образовательные материалы

# Site
SITE_BASE_URL=http://localhost:8000
COOKIE_SECURE=false

# Marzban via WireGuard (фаза B)
# Продакшен (через туннель): http://10.10.0.1:8000
# Локальная разработка (SSH-туннель): http://host.docker.internal:18000
MARZBAN_BASE_URL=http://10.10.0.1:8000
MARZBAN_ADMIN_USER=admin
MARZBAN_ADMIN_PASSWORD=
MARZBAN_INBOUND_TAG=VLESS TCP REALITY
MARZBAN_TOKEN_CACHE_MINUTES=55
MARZBAN_REQUEST_TIMEOUT_SECONDS=30
# Не ходить в Marzban при F5 в ЛК, если кэш свежее N сек (0 = никогда при открытии страницы)
MARZBAN_CABINET_SYNC_TTL_SECONDS=300
MARZBAN_JOB_POLL_INTERVAL_SECONDS=60
MARZBAN_JOB_MAX_ATTEMPTS=10
MARZBAN_JOB_RETRY_DELAY_SECONDS=120

# Scheduler (фаза D)
REMINDER_CRON_HOUR=10
REMINDER_TIMEZONE=Europe/Moscow
